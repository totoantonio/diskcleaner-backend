    <item>
    <title>Version 26.1.1.4</title>
    <sparkle:version>21</sparkle:version>
    <sparkle:shortVersionString>26.1.1.4</sparkle:shortVersionString>
    <pubDate>Tue, 30 Jun 2026 00:00:00 +0000</pubDate>
    <description><![CDATA[
        <ul>
            <li>New: DNS Refresh now shows Wi-Fi strength, link speed, and DNS server details.</li>
            <li>Improved: DNS Refresh loads network diagnostics in the background for faster display.</li>
            <li>Improved: Menu bar Open DiskCleaner now focuses the existing app window instead of opening a duplicate.</li>
            <li>Fix: Reduced cleaning UI stalls by pausing Trash monitoring during cleanup.</li>
            <li>Fix: Skips unreadable Trash roots to avoid repeated permission errors.</li>
        </ul>
    ]]></description>
    <enclosure url="https://www.diskcleaner.pro/downloads/DiskCleaner-macOS.dmg" sparkle:edSignature="lzjuaK7xmZ0JAyVEorNlEKRbCVIe9l2V4EZkaovxspCjKCxe8DR60DriueQddszzpuWKvTIkhMJxDSYl8XZ5AA==" length="10167106" type="application/octet-stream"/>
</item>
    
    <item>
        <title>Version 26.1.1.3</title>
        <sparkle:version>20</sparkle:version>
        <sparkle:shortVersionString>26.1.1.3</sparkle:shortVersionString>
        <pubDate>Mon, 29 Jun 2026 00:00:00 +0000</pubDate>
        <description><![CDATA[
            <ul>
                <li>Improved: Smoother scanning and cleaning progress with fewer layout jumps.</li>
                <li>Improved: Active scan and cleanup views now keep stable gauge, row, and text areas during progress updates.</li>
                <li>New: Post-cleanup summary now shows an after-cleanup sunburst and cleaned location breakdown.</li>
                <li>Improved: Cleanup wording is clearer and no longer describes Trash moves as immediately “freed” space.</li>
                <li>Improved: Trash messaging now explains that items are moved to Trash when possible and Trash is not emptied automatically.</li>
                <li>Fix: Status header no longer leaves ghosted text during scan and cleanup transitions.</li>
                <li>Improved: Routine cleanup and diagnostics console logging is quieter by default.</li>
            </ul>
        ]]></description>
        <enclosure url="https://www.diskcleaner.pro/downloads/DiskCleaner-macOS.dmg" sparkle:edSignature="lzjuaK7xmZ0JAyVEorNlEKRbCVIe9l2V4EZkaovxspCjKCxe8DR60DriueQddszzpuWKvTIkhMJxDSYl8XZ5AA==" length="10167106" type="application/octet-stream"/>
    </item>

    <item>
    <title>Version 26.1.1.2</title>
    <sparkle:version>19</sparkle:version>
    <sparkle:shortVersionString>26.1.1.2</sparkle:shortVersionString>
    <pubDate>Mon, 01 Jun 2026 00:00:00 +0000</pubDate>
    <description><![CDATA[
        <ul>
            <li>New: Time Machine Snapshots scanning and cleaning (Premium)</li>
            <li>New: Old Installers detection — DMG, PKG, ISO files (Premium)</li>
            <li>Improved: Spring animations and frosted glass sidebar</li>
            <li>Fix: Clicking a folder header now selects/deselects all items at once</li>
        </ul>
    ]]></description>
    <enclosure url="https://www.diskcleaner.pro/downloads/DiskCleaner-macOS.dmg" sparkle:edSignature="DdzQdRbBpvj6MucFxjtigGLklPmi/KP58qMxWA5ZFJx/Om8+0boOqdcyuCH/WGOCkGvD93SZ1W1wtvMHcOIuBQ==" length="3450077" type="application/octet-stream"/>
